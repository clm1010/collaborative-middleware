# ==========================================================
# collaborative-middleware 环境变量模板
# ==========================================================
#
# 本文件入 git，作为配置项的"文档 + 默认值"参考；.env 出 git，各环境独立维护。
# 部署流程：cp .env.example .env，再按下方 "开发 vs 生产差异参考表" 调整值即可。
#
# 加载规则（参见 src/app.module.ts）：
#   ConfigModule 仅加载 .env 一个文件（envFilePath: '.env'）。
#   如需临时覆盖，可在启动命令前 inline 注入，例如：
#     DOC_IDLE_CLEANUP_MINUTES=0.1 pnpm start:dev

# ==========================================================
# 支持的环境变量（代码实际引用位置）
# ==========================================================
#   COLLABORATIVE_MIDDLEWARE_PORT  中间件监听端口         (src/main.ts)
#   CORS_ORIGIN                    允许的跨域来源          (src/main.ts)
#   NODE_ENV                       development / production (src/main.ts)
#   DOC_IDLE_CLEANUP_MINUTES       空闲清理窗口（分钟）   (src/common/resolveIdleCleanupMs.ts)

# ---- 服务运行时 ----
# 中间件监听端口
COLLABORATIVE_MIDDLEWARE_PORT=3001

# CORS 允许的来源，逗号分隔
# 留空或不设置 = 允许全部 (*)
# 示例: CORS_ORIGIN=http://localhost:5173,https://your-domain.com
CORS_ORIGIN=

# 运行环境：development / production
NODE_ENV=development

# ---- 协同清理策略 ----
# 最后一个客户端断开后，空闲多少分钟执行 LevelDB 压缩 + Y.Doc 销毁
# 支持小数（0.5 = 30 秒）；非法值（空串 / NaN / <=0）回退为 1
# 对 /collaboration 与 /markdown 两个网关同时生效
#
# 注意：除非调试/复现 Bug（如临时调成 0.1 分钟=6 秒观察清理日志），
# 否则默认值 1 分钟即可，**无需按 dev/prod 区分** —— 该值对业务体验
# 和服务器资源占用都几乎无感，纯粹是排障时的逃生通道。
DOC_IDLE_CLEANUP_MINUTES=1

# ==========================================================
# 开发 vs 生产 差异参考表
# ==========================================================
# 部署新环境时，只有下表列出的变量需要按环境区分调整，其它保持默认即可。
# （DOC_IDLE_CLEANUP_MINUTES 不在此表内，因为它对业务无感，默认 1 分钟适用于所有环境）
#
# ┌──────────────────────────────┬─────────────────────────┬──────────────────────────────────┐
# │ 变量                          │ 开发环境建议             │ 生产环境建议                      │
# ├──────────────────────────────┼─────────────────────────┼──────────────────────────────────┤
# │ NODE_ENV                     │ development             │ production                       │
# ├──────────────────────────────┼─────────────────────────┼──────────────────────────────────┤
# │ CORS_ORIGIN                  │ 留空（放开全部）         │ 严格填写前端域名，逗号分隔         │
# │                              │ 或 http://localhost:5173 │ 例: https://admin.your-domain.com │
# ├──────────────────────────────┼─────────────────────────┼──────────────────────────────────┤
# │ COLLABORATIVE_MIDDLEWARE_PORT│ 3001                    │ 3001（或按网关统一规划改）         │
# └──────────────────────────────┴─────────────────────────┴──────────────────────────────────┘
#
# 生产额外注意事项：
#   - 启动命令使用 `pnpm start:prod`，自动注入 NODE_ENV=production 并以编译产物运行
#   - 若前后端跨域部署，务必将具体前端源写入 CORS_ORIGIN，不要保持 *（留空等同于 *）
#   - LevelDB 目录 ./yjs-data/ 需保证写权限与磁盘空间；跨部署迁移请整目录复制
