# ========================================
# collaborative-middleware 环境配置示例
# 复制此文件为 .env 并修改配置
# ========================================

# 服务端口
COLLABORATIVE_MIDDLEWARE_PORT=3001

# CORS 允许的来源（逗号分隔，留空则允许所有来源）
# 开发环境示例：
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# 生产环境示例：
# CORS_ORIGIN=http://your-domain.com,https://your-domain.com

# 环境 (development / production)
NODE_ENV=development

# ========================================
# 服务说明
# ========================================
# 本中间件仅提供 WebSocket 协同编辑服务：
# - ws://localhost:3001/collaboration/{docId} - 文档协同
# - ws://localhost:3001/markdown/{docId} - Markdown 协同
#
# HTTP API 已迁移到前端直接调用 Java 后端
